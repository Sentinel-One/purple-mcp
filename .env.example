# Purple MCP Server Configuration
# Copy this file to .env and fill in the required values

# Required: Service token for Console and SDL access
# Note: Token must have "Account" or "Site" level permissions (not "Global")
PURPLEMCP_CONSOLE_TOKEN=your_sentinelone_console_token

# Required: Base URL for SentinelOne console, no trailing slash
PURPLEMCP_CONSOLE_BASE_URL=https://your-console.sentinelone.net

# Optional: GraphQL API endpoints (defaults shown below)
# PURPLEMCP_CONSOLE_GRAPHQL_ENDPOINT=/web/api/v2.1/graphql
# PURPLEMCP_ALERTS_GRAPHQL_ENDPOINT=/web/api/v2.1/unifiedalerts/graphql


# Optional: Dedicated base URL for the SDL API.
# When set, this URL is used directly instead of PURPLEMCP_CONSOLE_BASE_URL + /sdl.
# PURPLEMCP_SDL_BASE_URL=https://your-dedicated-sdl-endpoint.sentinelone.net

# Optional: Define the account-ID(s) to use when querying SDL.
# If undefined, will default to using account scope of the supplied PURPLEMCP_CONSOLE_TOKEN.
# export PURPLEMCP_SDL_CONSOLE_ACCOUNT_IDS="123456789012345678"

# Optional: Console scope IDs
# PURPLEMCP_PURPLE_AI_CONSOLE_TENANT_ID=1234567890123456789
# PURPLEMCP_PURPLE_AI_CONSOLE_ACCOUNT_ID=1234567890123456789
# PURPLEMCP_PURPLE_AI_CONSOLE_SITE_ID=1234567890123456789

# Optional: console (deployment) ID
# PURPLEMCP_PURPLE_AI_CONSOLE_ID=1234567890123456789

# Optional: Purple AI client/user metadata (all optional)
# PURPLEMCP_PURPLE_AI_EMAIL_ADDRESS=analyst@example.com
# PURPLEMCP_PURPLE_AI_CONSOLE_VERSION=S-25.1.1#30
# PURPLEMCP_PURPLE_AI_BUILD_DATE="01/15/2025, 10:30:00 AM"
# PURPLEMCP_PURPLE_AI_BUILD_HASH=abc123def456

# Environment Type - Controls security behavior (IMPORTANT for release environments)
# Valid values:
#   - release/production/prod: TLS certificate verification bypass is FORBIDDEN (enforced)
#   - development/dev: TLS bypass allowed with security warnings
#   - testing/test/staging: TLS bypass allowed with enhanced warnings
# Default: release (if not set) - secure by default
# NOTE: Set to 'release' for local development if needed
PURPLEMCP_ENV=release

# Optional Observability
# PURPLEMCP_LOGFIRE_TOKEN=pylf_...
# PURPLEMCP_LOGFIRE_SERVICE_NAME=PurpleMCP
